{
  "name": "prsnooze",
  "version": "0.1.0",
  "description": "prsnooze: PR reviews through Claude Code or Codex. Paste a GitHub PR URL, run the selected provider with the project's review skill, and post the review back to the PR.",
  "main": "server.js",
  "type": "commonjs",
  "bin": {
    "prsnooze": "bin/start.js",
    "prsnooze-service": "bin/prsnooze-service"
  },
  "scripts": {
    "start": "node bin/start.js",
    "test": "node --test",
    "check": "node bin/start.js --check",
    "start:nochecks": "node bin/start.js --no-check",
    "service": "bin/prsnooze-service",
    "service:start": "bin/prsnooze-service start",
    "service:stop": "bin/prsnooze-service stop",
    "service:restart": "bin/prsnooze-service restart",
    "service:status": "bin/prsnooze-service status",
    "service:logs": "bin/prsnooze-service logs",
    "service:install": "bin/prsnooze-service install",
    "service:uninstall": "bin/prsnooze-service uninstall",
    "docker:start": "bin/docker-server start",
    "docker:stop": "bin/docker-server stop",
    "docker:restart": "bin/docker-server restart",
    "docker:rebuild": "bin/docker-server rebuild",
    "docker:ssh": "bin/docker-server ssh",
    "docker:claude-login": "bin/docker-server claude-login",
    "docker:codex-login": "bin/docker-server codex-login",
    "docker:gh-login": "bin/docker-server gh-login",
    "docker:logs": "bin/docker-server logs",
    "docker:status": "bin/docker-server status"
  },
  "dependencies": {
    "express": "^5.2.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=20"
  }
}
