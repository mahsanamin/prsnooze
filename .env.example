# prsnooze config — copy to .env (or run `npm start`, which auto-creates it)

# HTTP port. Bound to 0.0.0.0; expose via LAN/Tailscale at your own discretion.
PORT=8284

# Where repos, worktrees, and job state live. Defaults to ~/.prsnooze/.
# Override either PRSNOOZE_HOME (one knob) or each path individually.
# PRSNOOZE_HOME=
# REPOS_DIR=
# WORKTREES_DIR=
# OUTPUTS_DIR=

# Worktree cleanup policy.
# false = delete worktree on success, keep on failure (recommended)
# true  = always keep worktree (useful while iterating)
KEEP_WORKTREES_ON_SUCCESS=false

# Mark prsnooze's own clones as trusted workspaces in ~/.claude.json.
# Claude Code otherwise ignores the reviewed repo's .claude/settings.json and
# its project-level skills, because trust is granted by a dialog that only
# appears in an interactive session — which prsnooze never opens.
# false = never touch ~/.claude.json (reviews still run, with less of the
# repo's own config in effect).
PRSNOOZE_TRUST_CLONES=true

# Path/command to the claude CLI. Override if claude is not on PATH.
CLAUDE_BIN=claude

# How git talks to GitHub: https (default) or ssh.
#
# https uses the token `gh` is already authenticated with, so cloning and
# fetching need no SSH key and no ssh-agent. That matters when prsnooze runs as
# a background service: it gets its own empty ssh-agent, never the loaded one
# from your terminal, so an SSH clone fails with "Permission denied (publickey)"
# on a machine where git works fine by hand.
#
# Set to ssh only if your gh token can't read the repos you want reviewed but
# your key can. Then the key must work with no agent (macOS: run
# `ssh-add --apple-use-keychain ~/.ssh/<your-key>` once).
PRSNOOZE_GIT_TRANSPORT=https

# Auto-approve PRs with no critical/major issues.
# When true, the reviewer computes a risk score from the diff (see the
# scoring rubric in lib/claude-runner.js). PRs score ≤20 → --approve;
# 21–60 → --comment; >60 → --comment with a high-risk banner. Real
# behavior changes in auth/payments/DB-migration weight +50 each and
# cap reducers at −20, so a real top-3 change never auto-approves.
# When AUTO_APPROVE=false, every review is --comment, period.
AUTO_APPROVE=true

# Confidence threshold for findings. Default guidance only — if the project's
# inlined review skill specifies its own filter, the SKILL takes precedence.
# Set to 0 to disable filtering (every finding surfaced).
CONFIDENCE_THRESHOLD=80

# Skip re-reviewing the same commit SHA if the gh-authenticated user has
# already posted a review on it. Saves an entire Claude run on no-op
# resubmissions.
SKIP_IF_ALREADY_REVIEWED=true

# How many PR reviews run at once. Default 1 = sequential (one at a time; no
# concurrency). Set >1 to allow that many concurrent reviews. Each review gets
# its own worktree and Claude session; only the per-repo git prep (fetch +
# worktree add) takes turns, so same-repo reviews never race on the shared
# clone. Higher = more host CPU/RAM and more concurrent Claude/GitHub API load.
MAX_CONCURRENT_REVIEWS=1

# Password for the manual "Approve PR" button. Whoever knows it can approve;
# it's asked for on every approval and only ever checked here, never sent to the
# browser and never remembered by it.
#
# The button is always on screen. Leave this unset and the flow is the same, it
# just always answers "not authorized" — so nothing gets approved by accident on
# a host that hasn't set one. Approvals post under this machine's `gh` login, so
# gh must be installed + authenticated (see README).
# MANUAL_APPROVE_PASSWORD=change-me

# Landscape hero image shown on the home page.
#
# Per-deployment pattern (recommended): drop your image at
#   public/heroes/local-hero.<ext>     # .jpg / .png / .svg / .webp — any
# The pattern public/heroes/local-hero.* is gitignored, so your image
# stays out of the public repo. Then set:
#   HERO_IMAGE=/heroes/local-hero.<ext>
#
# Bundled fallbacks (checked into the repo — safe defaults):
#   /heroes/sleepy-cat.svg     orange tabby curled up under stars
#   /heroes/pink-panther.svg   smug pink long-cat, "cool. calm. reviewing."
#   /heroes/moon-night.svg     crescent moon with stars and hills
#
# You can also point HERO_IMAGE at any full URL.
#
# Leave this unset (the default) and the page draws its own night sky in CSS —
# no image needed. Setting it fades your image in over the bottom of that sky.
# HERO_IMAGE=/heroes/local-hero.jpg
